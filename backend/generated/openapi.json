					},
					"endedAt": {
						"type": "string"
					},
					"developerTurns": {
						"type": "string"
					},
					"inputTokens": {
						"type": "string"
					},
					"cachedInputTokens": {
						"type": "string"
					},
					"outputTokens": {
						"type": "string"
					},
					"totalTokens": {
						"type": "string"
					},
					"usageObserved": {
						"type": "boolean"
					},
					"importState": {
						"type": "string"
					}
				},
				"required": [
					"sessionId",
					"developerTurns",
					"inputTokens",
					"cachedInputTokens",
					"outputTokens",
					"totalTokens",
					"usageObserved",
					"importState"
				],
				"type": "object",
				"additionalProperties": false
			},
			"SessionPageResponse": {
				"properties": {
