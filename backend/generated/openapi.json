						}
					}
				},
				"tags": [
					"Imports"
				],
				"security": [],
				"parameters": []
			}
		},
		"/api/imports/rescan": {
			"post": {
				"operationId": "Rescan",
				"responses": {
					"202": {
						"description": "Accepted",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RescanResponse"
								}
							}
						}
					}
				},
				"tags": [
					"Imports"
				],
				"security": [],
				"parameters": []
			}
		}
	},
