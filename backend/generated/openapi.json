				"parameters": []
			}
		},
		"/api/linear/sync": {
			"post": {
				"operationId": "Sync",
				"responses": {
					"202": {
						"description": "Synchronization accepted",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LinearSyncResponse"
								}
							}
						}
					},
					"409": {
						"description": "Linear is not configured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"tags": [
					"Linear"
				],
				"security": [],
				"parameters": []
			}
		},
		"/api/imports/status": {
			"get": {
