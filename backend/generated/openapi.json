				"required": [
					"source",
					"status",
					"completeOffset",
					"unknownRecords",
					"malformedRecords"
				],
				"type": "object",
				"additionalProperties": false
			},
			"ImportStatusResponse": {
				"properties": {
					"roots": {
						"items": {
							"$ref": "#/components/schemas/RootStatusResponse"
						},
						"type": "array"
					},
					"currentRun": {
						"$ref": "#/components/schemas/ImportRunResponse"
					},
					"lastCompletedRun": {
						"$ref": "#/components/schemas/ImportRunResponse"
					},
					"checkpoints": {
						"items": {
							"$ref": "#/components/schemas/CheckpointStatusResponse"
						},
						"type": "array"
					},
