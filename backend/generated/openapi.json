					}
				},
				"required": [
					"root",
					"available",
					"discoveredFiles"
				],
				"type": "object",
				"additionalProperties": false
			},
			"ImportRunResponse": {
				"properties": {
					"runId": {
						"type": "string"
					},
					"trigger": {
						"type": "string"
					},
					"state": {
						"type": "string"
					},
					"startedAt": {
						"type": "string"
					},
					"completedAt": {
						"type": "string"
					},
					"rootsDiscovered": {
						"type": "number",
						"format": "double"
					},
					"filesDiscovered": {
						"type": "number",
						"format": "double"
					},
					"filesImported": {
						"type": "number",
						"format": "double"
					},
					"sessionsImported": {
						"type": "number",
						"format": "double"
					},
					"warnings": {
						"type": "number",
						"format": "double"
					},
					"errors": {
						"type": "number",
						"format": "double"
					},
					"summary": {
						"type": "string"
					}
				},
				"required": [
					"runId",
					"trigger",
					"state",
					"rootsDiscovered",
					"filesDiscovered",
					"filesImported",
					"sessionsImported",
					"warnings",
					"errors"
				],
				"type": "object",
				"additionalProperties": false
			},
			"CheckpointStatusResponse": {
				"properties": {
