{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./__tests__/*"]
    },
    "lib": ["ES2023"],
    "types": ["node", "bun"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "__tests__", "tsoa.json"]
}
