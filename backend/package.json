{
  "name": "@ai-task-observer/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "start": "node dist/server.js",
    "generate": "tsoa spec-and-routes",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-migrations.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.3",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tsoa": "7.0.0-alpha.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
