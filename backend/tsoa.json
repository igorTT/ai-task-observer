{
  "entryFile": "src/app.ts",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/api/controllers/*controller.ts"],
  "spec": {
    "outputDirectory": "generated",
    "specVersion": 3,
    "specFileBaseName": "openapi"
  },
  "routes": {
    "routesDir": "src/api/generated",
    "middleware": "express",
    "esm": true
  }
}
