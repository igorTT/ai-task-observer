# Core backend and Codex ingestion settings. Linear credentials are not required yet.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/ai-task-observer.duckdb
LOG_LEVEL=info

# Comma-separated, read-only Codex Desktop session directories.
# Leave unset to use ~/.codex/sessions, or uncomment with an absolute override.
# CODEX_SESSION_ROOTS=/absolute/path/to/.codex/sessions
CODEX_READ_CHUNK_BYTES=1048576
CODEX_WATCH_DEBOUNCE_MS=1000
CODEX_ROOT_REDISCOVERY_MS=60000
