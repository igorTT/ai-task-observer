# Core backend and Codex ingestion settings. Linear credentials are optional.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/ai-task-observer.duckdb
LOG_LEVEL=info

# Optional application-owned model pricing catalog override.
# PRICING_CATALOG_PATH=/absolute/path/to/models.json
COST_CALCULATION_DEBOUNCE_MS=250

# Comma-separated, read-only Codex Desktop session directories.
# Leave unset to use ~/.codex/sessions, or uncomment with an absolute override.
# CODEX_SESSION_ROOTS=/absolute/path/to/.codex/sessions
CODEX_READ_CHUNK_BYTES=1048576
CODEX_WATCH_DEBOUNCE_MS=1000
CODEX_ROOT_REDISCOVERY_MS=60000

# Optional read-only Linear issue attribution. Leave LINEAR_API_KEY unset to keep
# ingestion and health available without making any Linear requests.
# LINEAR_API_KEY=lin_api_your_key
LINEAR_CACHE_TTL_MS=3600000
LINEAR_MAX_CONCURRENCY=4
